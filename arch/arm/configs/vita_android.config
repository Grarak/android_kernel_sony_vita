# Android 8.1 (LineageOS 15.1, Android Go) additions for the PlayStation Vita.
# Merged onto vita_defconfig to produce vita_android_defconfig:
#   scripts/kconfig/merge_config.sh -m arch/arm/configs/vita_defconfig \
#       arch/arm/configs/vita_android.config
#
# --- CPU: Cortex-A9 r2p10 MPCore, Thumb-2 kernel, VFPv3 + NEON ---
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VITA=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_THUMB2_KERNEL=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_764369=y
CONFIG_ARM_ERRATA_775420=y
CONFIG_PL310_ERRATA_769419=y
CONFIG_CACHE_L2X0=y
CONFIG_HAVE_ARM_TWD=y
CONFIG_ARM_GLOBAL_TIMER=y
CONFIG_CLKSRC_ARM_GLOBAL_TIMER_SCHED_CLOCK=y
CONFIG_HZ_250=y
CONFIG_HIGHMEM=y
CONFIG_AEABI=y
CONFIG_ARM_APPENDED_DTB=n
CONFIG_ARM_ATAG_DTB_COMPAT=n
# NEON-accelerated crypto: the 7.x lib/crypto arch code (SHA-1/256/512,
# ChaCha, Poly1305, XOR) picks the NEON versions by itself.
CONFIG_CRYPTO_AES_ARM_BS=y
CONFIG_CRYPTO_GHASH_ARM_CE=n
#
# --- The 7.3 context-analysis warnings trip over this clang 23.0.1 snapshot
# (include/linux/blkdev.h: "use of undeclared identifier 'bdev'").
CONFIG_WARN_CONTEXT_ANALYSIS=n
#
# --- No embedded initramfs: the Android boot.img ramdisk comes from the loader
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
#
# --- Vita drivers
CONFIG_BLK_DEV_VITA_MSIF=y
CONFIG_SCE_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_VITA=y
CONFIG_GPIO_VITA=y
CONFIG_SPI=y
CONFIG_SPI_VITA=y
CONFIG_MFD_VITA_SYSCON=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_VITA=y
CONFIG_RESET_VITA=y
CONFIG_SERIAL_VITA_UART=y
CONFIG_SERIAL_VITA_UART_CONSOLE=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_VITA_BUTTONS=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_VITA_SYSCON=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
#
# --- Display: loader-initialised framebuffer. fbdev simplefb gives Android
# 8.1's gralloc.default its /dev/graphics/fb0.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=n
CONFIG_SYSFB_SIMPLEFB=n
#
# --- Android: binder (Treble needs binder, hwbinder and vndbinder), ashmem
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_KEYCHORD=n
CONFIG_FUSE_FS=y
# No suspend yet (needs the Syscon/SMC sequence), and so no /sys/power/wake_lock:
# 8.1's libpower and libsuspend log and carry on without them.
CONFIG_SUSPEND=n
CONFIG_PROFILING=y
CONFIG_PERF_EVENTS=y
CONFIG_STAGING=y
#
# --- Android base (android-base.config for O): cgroups v1, namespaces,
# SELinux, seccomp, audit, IPv6, netfilter
CONFIG_AUDIT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="selinux"
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=n
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_XFRM_USER=y
CONFIG_NET_KEY=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_MPPE=y
CONFIG_PPPOLAC=n
CONFIG_PPPOPNS=n
CONFIG_L2TP=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
# 8.1's iptables/ip6tables are the legacy xtables front ends
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_CLS_ACT=y
CONFIG_RFKILL=y
#
# --- WLAN/BT: Marvell 88W8787 ("Robin") on SceSdif2, powered through the
# Syscon (pwrseq_vita_wlanbt). mrvl/sd8787_uapsta.bin comes from
# /vendor/firmware through ueventd: the drivers are built in and probe
# before /vendor is mounted, so the firmware loader falls back to the
# uevent interface and waits for ueventd's coldboot.
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_SDIO=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_MRVL=y
CONFIG_BT_MRVL_SDIO=y
CONFIG_PWRSEQ_VITA_WLANBT=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
#
# --- Filesystems (system/vendor/data are ext4 images on the memory card's exFAT)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_DM_VERITY=n
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
#
# --- Android Go / low RAM (512 MiB): zram swap, userspace lmkd via memcg
# pressure (8.1 lmkd has no PSI support; PSI is enabled for newer lmkd)
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_PSI=y
CONFIG_KSM=y
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_SLUB=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=n
CONFIG_SCHED_AUTOGROUP=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=n
#
# --- Debug that costs little
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_PSTORE=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_VITA_UART0=y
CONFIG_EARLY_PRINTK=y

# --- wificond (user wifi, group net_admin) needs CAP_NET_ADMIN by group ---
CONFIG_ANDROID_PARANOID_NETWORK=y

# --- CPU frequency scaling: the ARM clock and VDDA by the device tree's OPPs ---
CONFIG_REGULATOR=y
CONFIG_REGULATOR_VITA_SYSCON=y
CONFIG_NVMEM_VITA_VID=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ARM_VITA_CPUFREQ=y
