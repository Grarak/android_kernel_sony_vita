config ARCH_VITA
	bool "Sony PlayStation Vita (CXD5315GG)"
	depends on ARCH_MULTI_V7
	select ARM_GIC
	select ARM_GLOBAL_TIMER
	select CACHE_L2X0
	select HAVE_ARM_SCU if SMP
	select HAVE_ARM_TWD if SMP
	select ARCH_HAS_RESET_CONTROLLER
	select RESET_CONTROLLER
	select PM_GENERIC_DOMAINS if PM
	help
	  Support for the Sony PlayStation Vita family (PCH-1000, PCH-2000,
	  VTE-1000 PlayStation TV and the DevKit/TestKit units), built around
	  the CXD5315GG SoC: 4x Cortex-A9 MPCore r2p10, PL310 L2 cache r3p1,
	  PowerVR SGX543MP4+.
